# Fyzioterapie Michaela Kokešová — proměnné prostředí
# Zkopíruj do .env.local a vyplň. .env.local nikdy necommituj.
# Produkční hodnoty patří výhradně do nastavení projektu ve Vercelu.

# --- Supabase (region EU) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Servisní klíč — jen na serveru, nikdy v klientském kódu, nikdy s prefixem NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (odesílání e-mailů z kontaktního formuláře) ---
RESEND_API_KEY=
# Odesílatel na ověřené subdoméně, ne na hlavní doméně
RESEND_FROM="Fyzioterapie Kokešová <formular@notifikace.fyzioterapiekokesova.cz>"
# Adresa, na kterou chodí zprávy z formuláře
KONTAKT_PRIJEMCE=

# --- Web ---
NEXT_PUBLIC_URL=https://www.fyzioterapiekokesova.cz

# --- Google Analytics 4 (načte se až po souhlasu) ---
NEXT_PUBLIC_GA_ID=

# Heslo administrátorky. Nepovinné.
# Když je vyplněné, `npm run admin` ho nastaví rovnou a neposílá e-mail.
# Zkratka pro vývoj — před předáním klientce musí být heslo změněné.
ADMIN_PASSWORD=

# Adresa administrace. Nepovinné.
# Když je vyplněná, administrace se obsluhuje na téhle poddoméně a na webové
# doméně se na ni jen přesměruje. Prázdné = administrace zůstává na /admin.
# Poddoménu je potřeba přidat i ve Vercelu v Settings -> Domains.
ADMIN_URL=

# Adresa veřejného webu. Nepovinné, používá se jen k rozdělení domén výše.
WEB_URL=
